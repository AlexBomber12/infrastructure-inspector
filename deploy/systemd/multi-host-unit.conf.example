INSPECTOR_UNIT_PRIVATE_GATEWAY=172.30.240.1
INSPECTOR_UNIT_EGRESS_IP=172.30.241.10
INSPECTOR_UNIT_EGRESS_BRIDGE=br-insp-example
INSPECTOR_UNIT_EXTERNAL_IPS="192.0.2.10"
